	"item": [
		{
			"name": "1. Auth & Reader",
			"item": [
				{
					"name": "1.1 Đăng ký độc giả mới (Register)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"docgia01\",\n  \"password\": \"MatKhau@123\",\n  \"fullName\": \"Nguyen Van A\",\n  \"email\": \"docgia01@example.com\",\n  \"phoneNumber\": \"0987654321\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/identity/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"identity",
								"register"
							]
						}
					},
					"response": []
				},
				{
					"name": "1.2 Đăng nhập Độc giả (Login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data) {",
									"    pm.environment.set(\"readerToken\", jsonData.data.accessToken);",
									"    pm.environment.set(\"refreshToken\", jsonData.data.refreshToken);",
									"    pm.collectionVariables.set(\"readerToken\", jsonData.data.accessToken);",
									"    pm.collectionVariables.set(\"refreshToken\", jsonData.data.refreshToken);",
									"    console.log(\"Saved readerToken & refreshToken\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"docgia01\",\n  \"password\": \"MatKhau@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/identity/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"identity",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "1.3 Xem hồ sơ cá nhân (Get Profile)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{readerToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/identity/profile",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"identity",
								"profile"
							]
						}
					},
					"response": []
				},
				{
					"name": "1.4 Cập nhật hồ sơ (Update Profile)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{readerToken}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fullName\": \"Nguyen Van A Updated\",\n  \"phoneNumber\": \"0987654322\",\n  \"address\": \"123 Nguyen Trai, Q5, TP.HCM\",\n  \"dateOfBirth\": \"2000-01-15\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/identity/profile",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"identity",
								"profile"
							]
						}
					},
					"response": []
				},
				{
					"name": "1.5 Đổi mật khẩu (Change Password)",
