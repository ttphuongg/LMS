							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/identity/logout",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"identity",
								"logout"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Admin Management",
			"item": [
				{
					"name": "2.1 Đăng nhập Admin mặc định",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data) {",
									"    pm.environment.set(\"adminToken\", jsonData.data.accessToken);",
									"    pm.collectionVariables.set(\"adminToken\", jsonData.data.accessToken);",
									"    console.log(\"Saved adminToken\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/identity/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"identity",
								"login"
							]
						}
					},
					"response": []
				},
				{
