  "item": [
    {
      "name": "1. Identity - Xác thực & Cá nhân",
      "description": "Các chức năng Đăng ký, Đăng nhập, Quản lý phiên và Thông tin cá nhân",
      "item": [
        {
          "name": "1.1 Đăng ký Độc giả mới (Register)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "    pm.collectionVariables.set('createdUserId', res.data);",
                  "    console.log('Saved createdUserId: ' + res.data);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"reader01\",\n  \"password\": \"Password@123\",\n  \"fullName\": \"Nguyen Van A\",\n  \"email\": \"reader01@example.com\",\n  \"phoneNumber\": \"0912345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/identity/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "identity",
                "register"
              ]
            }
          }
        },
        {
          "name": "1.2 Đăng nhập Độc giả (Login Reader)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "    pm.collectionVariables.set('readerToken', res.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "    pm.collectionVariables.set('createdUserId', res.data.accountId);",
                  "    console.log('Saved readerToken & refreshToken for: ' + res.data.username);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"reader01\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/identity/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "identity",
                "login"
              ]
            }
          }
        },
        {
          "name": "1.3 Đăng nhập Admin mặc định (Login Admin)",
